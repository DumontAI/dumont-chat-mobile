## You invoke this with --env ios.release on the fastlane command
APP_NAME=Dumont Chat
APP_SCHEME=dumontchat
AWS_BUCKET_DNS_NAME=
AWS_FOLDER_NAME=
AWS_REGION=us-east-1
BUILD_FOR_RELEASE=true
COLLECT_NETWORK_METRICS=false
EXTENSION_APP_IDENTIFIER=chat.dumont.app.Share
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_XCODEBUILD_SETTINGS_RETRIES=6
IOS_APP_GROUP=group.chat.dumont
IOS_BUILD_EXPORT_METHOD=app-store
IOS_ICLOUD_CONTAINER=
MAIN_APP_IDENTIFIER=chat.dumont.app
MATCH_APP_IDENTIFIER=chat.dumont.app.NotificationService,chat.dumont.app.Share,chat.dumont.app
MATCH_READONLY=true
MATCH_SHALLOW_CLONE=true
MATCH_SKIP_DOCS=true
MATCH_TYPE=appstore
NOTIFICATION_SERVICE_IDENTIFIER=chat.dumont.app.NotificationService
PILOT_SKIP_WAITING_FOR_BUILD_PROCESSING=true
REPLACE_ASSETS=true
SENTRY_ENABLED=false
SENTRY_ORG=
SENTRY_PROJECT_IOS=
SHOW_ONBOARDING=false
SHOW_REVIEW=false
SYNC_PROVISIONING_PROFILES=false

INTUNE_ENABLED=false
INTUNE_CLIENT_ID=
APP_AUTH_SCHEME=dumontauth
APP_AUTH_SCHEME_BETA=dumontauthbeta
# Project pbxproj ships Mattermost team UQ8HT4Q2XM; ours is 5VQ28Z7532.
FASTLANE_TEAM_ID=5VQ28Z7532
TEAM_ID=5VQ28Z7532
