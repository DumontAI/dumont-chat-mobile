## You invoke this with --env android.release on the fastlane command
APP_NAME=Dumont Chat
APP_SCHEME=dumontchat
AWS_BUCKET_DNS_NAME=
AWS_FOLDER_NAME=
AWS_REGION=us-east-1
BETA_BUILD=false
BUILD_FOR_RELEASE=true
COLLECT_NETWORK_METRICS=false
MAIN_APP_IDENTIFIER=chat.dumont.app
REPLACE_ASSETS=true
SENTRY_ENABLED=false
SENTRY_ORG=
SENTRY_PROJECT_ANDROID=
SEPARATE_APKS=true
SHOW_ONBOARDING=false
SHOW_REVIEW=false
SUPPLY_PACKAGE_NAME=chat.dumont.app
SUPPLY_TRACK=beta
SUPPLY_VALIDATE_ONLY=false
APP_AUTH_SCHEME=dumontauth
APP_AUTH_SCHEME_BETA=dumontauthbeta
